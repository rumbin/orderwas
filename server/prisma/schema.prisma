generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Event {
  id                String   @id @default(cuid())
  name              String
  status            String   @default("test") // "test" | "live"
  hidePrices        Boolean  @default(false)
  tseEnabled        Boolean  @default(false)
  lastTearOffNumber Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  stations          Station[]
  waiters           Waiter[]
  orders            Order[]
  printers          Printer[]
  vouchers          Voucher[]
}

model Station {
  id              String   @id @default(cuid())
  name            String
  logo            String?
  printerId       String?
  printer         Printer? @relation(fields: [printerId], references: [id])
  kitchenMonitor  Boolean  @default(false)
  sortOrder       Int      @default(0)
  copyPrint       Boolean  @default(false)
  eventId         String
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  products        Product[]
  altPrinters     StationAltPrinter[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model StationAltPrinter {
  id         String   @id @default(cuid())
  stationId  String
  station    Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  printerId  String
  printer    Printer  @relation(fields: [printerId], references: [id])
  tableFrom  String?
  tableTo    String?
  pickupCode String?
}

model Printer {
  id           String   @id @default(cuid())
  name         String
  type         String   @default("network") // "network" | "ignore" | "dummy"
  ip           String?
  charsPerLine Int      @default(42)
  font         String   @default("A")
  buzzer       Boolean  @default(false)
  paperCut     String   @default("partial") // "full" | "partial" | "none"
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  stations     Station[]
  waiters      Waiter[]
  altFor       StationAltPrinter[]
}

model Product {
  id         String   @id @default(cuid())
  name       String
  shortName  String?
  priceCents Int
  taxRateBps Int      @default(2000) // basis points: 2000 = 20.00%
  stationId  String
  station    Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  available  Boolean  @default(true)
  isVoucher  Boolean  @default(false)
  addable    Boolean  @default(true)
  stockMode  String   @default("none") // "none" | "tracked" | "composite"
  stockCount Float    @default(0)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  orderItems OrderItem[]
  components ProductComponent[] @relation("Composite")
  usedIn     ProductComponent[] @relation("Ingredient")
}

model ProductComponent {
  id           String  @id @default(cuid())
  compositeId  String
  composite    Product @relation("Composite", fields: [compositeId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Product @relation("Ingredient", fields: [ingredientId], references: [id])
  quantity     Float   // decimal quantities allowed (0.5L beer from 1L unit)
}

model Waiter {
  id           String   @id @default(cuid())
  name         String
  pin          String
  logo         String?
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  printerId    String?
  printer      Printer? @relation(fields: [printerId], references: [id])
  pickupCode   String?  // Abholkennzeichen — waiter's orders skip table entry
  printsImmediately Boolean @default(true)
  canCancel    Boolean  @default(false)
  canCashOut   Boolean  @default(false)
  canStatistics Boolean @default(false)
  canCreateWaiters Boolean @default(false)
  canTransfer  Boolean  @default(false)
  isStationWaiter Boolean @default(false)
  hidden       Boolean  @default(false)
  autoSammelbon Boolean @default(false)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders       Order[]
}

model Order {
  id            String      @id @default(cuid())
  tableNumber   String?
  waiterId      String
  waiter        Waiter      @relation(fields: [waiterId], references: [id])
  eventId       String
  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status        String      @default("open") // "open" | "preparing" | "partial" | "paid" | "cancelled"
  totalCents    Int         @default(0)
  comment       String?
  tearOffNumber Int?
  pickupCode    String?
  sammelbonId   String?     // reserved for Phase 6 collective receipts
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
  status    String  @default("open") // "open" | "prepared" | "delivered" | "cancelled"
  comment   String?
}

model Voucher {
  id              String    @id @default(cuid())
  eventId         String
  event           Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  code            String
  valueCents      Int
  status          String    @default("active") // "active" | "redeemed" | "expired"
  redeemedOrderId String?
  createdAt       DateTime  @default(now())
  redeemedAt      DateTime?
  @@unique([eventId, code])
}

model AppLayout {
  id        String   @id @default(cuid())
  eventId   String
  waiterId  String?
  columns   Int      @default(3)
  rows      Int      @default(5)
  buttons   String   @default("[]") // JSON array of {name, color, productId, row, col}
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}